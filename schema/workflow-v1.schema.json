{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hallmark:workflow:1",
  "title": "Hallmark trusted local workflow v1",
  "description": "Wire shape. hallmark plan also checks graph, digests, output references, adapter effects and release verification ancestry. JSON Schema validation alone does not admit execution.",
  "maxProperties": 6,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedExecutables": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "Build",
              "Install",
              "Configure",
              "Migrate",
              "Verify",
              "Release"
            ]
          },
          "effect": {
            "enum": [
              "Observation",
              "DesiredState",
              "Imperative"
            ]
          },
          "repeat": {
            "enum": [
              "Reconcile",
              "ExecuteOnce"
            ]
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operation": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "process"
                  },
                  "executable": {
                    "type": "string"
                  },
                  "arguments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "directory": {
                    "type": "string"
                  },
                  "environment": {
                    "$ref": "#/$defs/environment"
                  },
                  "stdinFile": {
                    "type": "string"
                  },
                  "expectedExit": {
                    "type": "integer"
                  }
                },
                "required": [
                  "type",
                  "executable",
                  "arguments"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "write-file"
                  },
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path",
                  "content"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "capture"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "compose-up"
                  },
                  "file": {
                    "type": "string"
                  },
                  "project": {
                    "type": "string",
                    "pattern": "^cf-[a-z0-9-]{1,50}$"
                  },
                  "environment": {
                    "$ref": "#/$defs/environment"
                  }
                },
                "required": [
                  "type",
                  "file",
                  "project"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "release"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "version"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "http"
                  },
                  "url": {
                    "type": "string"
                  },
                  "method": {
                    "enum": [
                      "GET",
                      "HEAD"
                    ]
                  },
                  "body": {
                    "type": "string"
                  },
                  "headers": {
                    "$ref": "#/$defs/environment"
                  },
                  "status": {
                    "type": "integer"
                  },
                  "contains": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ]
              }
            ]
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800,
            "default": 120
          },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 128,
            "maximum": 4194304,
            "default": 262144
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrySafety": {
            "enum": [
              "manual",
              "reconcile",
              "external-ledger"
            ],
            "default": "manual"
          }
        },
        "required": [
          "id",
          "kind",
          "effect",
          "repeat",
          "operation"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "context",
    "inputs",
    "allowedExecutables",
    "steps"
  ],
  "$defs": {
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "secret"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/secret"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      }
    }
  }
}
