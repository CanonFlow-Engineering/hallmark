<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HallmarkTests.fs" />
    <Compile Include="RuntimeTests.fs" />
    <Compile Include="AdmissionTests.fs" />
    <Compile Include="TrxRunner.fs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="../src/Hallmark.fsproj" />
    <ProjectReference Include="../runtime/Hallmark.Runtime.fsproj" />
  </ItemGroup>
</Project>
