{
  "services": {
    "db": {
      "image": "postgres:18.7@sha256:2ea8630df176ad090ec92136dee850397c5af8781e4bcf2e4162593691c61bbc",
      "environment": {
        "POSTGRES_DB": "fsplayground_hallmark",
        "POSTGRES_USER": "fixture",
        "POSTGRES_PASSWORD": "${CF_DB_PASSWORD:-teardown-only}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U fixture -d fsplayground_hallmark"
        ],
        "interval": "1s",
        "timeout": "3s",
        "retries": 40
      },
      "volumes": [
        "database:/var/lib/postgresql"
      ],
      "mem_limit": "512m",
      "cpus": 1
    }
  },
  "volumes": {
    "database": {}
  }
}
